use StdIO: all;

#define EPSILON 0x1p-53

struct Vector3 {
    double x;
    double y;
    double z;
};

struct Body {
    struct Vector3 pos;
    struct Vector3 vel;
    double mass;
};

inline
struct Vector3 *(double a, struct Vector3 b)
{
    return Vector3 { _mul_SxS_(a, b.x), _mul_SxS_(a, b.y), _mul_SxS_(a, b.z) };
}

inline
struct Vector3[N] *(double a, struct Vector3[N] b)
{
    return { iv -> a * _sel_VxA_(iv, b) | iv < [N] };
}

inline
struct Vector3 +(struct Vector3 a, struct Vector3 b)
{
    return Vector3 { _add_SxS_(a.x, b.x), _add_SxS_(a.y, b.y), _add_SxS_(a.z, b.z) };
}

inline
struct Vector3[N] +(struct Vector3[N] a, struct Vector3[N] b)
{
    return { iv -> _sel_VxA_(iv, a) + _sel_VxA_(iv, b) | iv < [N] };
}

inline
struct Vector3 -(struct Vector3 a, struct Vector3 b)
{
    return Vector3 { _sub_SxS_(a.x, b.x), _sub_SxS_(a.y, b.y), _sub_SxS_(a.z, b.z) };
}

inline
double l2norm(struct Vector3 a)
{
    x = _mul_SxS_(a.x, a.x);
    y = _mul_SxS_(a.y, a.y);
    z = _mul_SxS_(a.z, a.z);
    return /*_sqrt_S_*/(_add_SxS_(_add_SxS_(x, y), z));
}

inline
double pow3(double x)
{
    return _mul_SxS_(_mul_SxS_(x, x), x);
}

inline
struct Vector3 acc(struct Body b1, struct Body b2)
{
    // dir = b2.pos - b.pos;
    // return dir * (b2.mass / pow3(EPSILON + l2norm(dir)));
    dir = b2.pos - b1.pos;
    factor = _eq_SxS_(pow3(l2norm(dir)), 0.0)
        ? 0.0
        : _div_SxS_(b2.mass, pow3(l2norm(dir)));
    return factor * dir;
}

noinline
struct Vector3[N] timestep(struct Body[N] bodies)
{
    ControlFlow::touch();

    return { [i] -> with {
                        ([0] <= [j] < [N]) : acc(_sel_VxA_([i], bodies), _sel_VxA_([j], bodies));
                    }: fold(+, Vector3 { 0.0, 0.0, 0.0 })
           | [i] < [N] };
}

int main()
{
    #ifndef N
    N = String::toi(CommandLine::argv(1));
    #endif

    bodies = { [i] -> Body { .pos = Vector3{ _tod_S_(i), _tod_S_(i), _tod_S_(i) },
                             .vel = Vector3{ _tod_S_(i), _tod_S_(i), _tod_S_(i) },
                             .mass = _tod_S_(i) }
             | [i] < [N] };

    for (i = 0; _lt_SxS_(i, 250); i = _add_SxS_(i, 1)) {
        rapl = Rapl::raplStart(0);
        sec1, nsec1 = MTClock::gettime();

        acc = timestep(bodies);

        sec2, nsec2 = MTClock::gettime();
        energy_uj = Rapl::raplStop(0, rapl);
        printf("%g,%g\n", MTClock::timediff(sec1, nsec1, sec2, nsec2), Rapl::tod(energy_uj));

        bodies.pos += 0.01 * bodies.vel;
        bodies.vel += 0.01 * acc;
    }

    return 0;
}
