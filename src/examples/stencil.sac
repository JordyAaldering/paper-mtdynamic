use StdIO: all;

inline
double +(double a, double b)
{
    return _add_SxS_(a, b);
}

inline
double sum(double[3,3] a)
{
    return with {
        ([0,0] <= iv < [3,3]): _sel_VxA_(iv, a);
    } : fold(+, 0.0);
}

noinline
double[N,N] stencil(double[N,N] arr, double[3,3] weights)
{
    ControlFlow::touch();

    return { [x,y] -> sum({ [i,j] ->
                _mul_SxS_(_sel_VxA_([i,j], weights),
                          _sel_VxA_([_mod_SxS_(_add_SxS_(_add_SxS_(N, x), _sub_SxS_(i, 1)), N),
                                     _mod_SxS_(_add_SxS_(_add_SxS_(N, y), _sub_SxS_(j, 1)), N)],
                                    arr))
                       })
           | [x,y] < [N,N] };
}

int main()
{
    #ifndef N
    N = String::toi(CommandLine::argv(1));
    #endif

    a = { [i,j] -> _tod_S_(_add_SxS_(i,j)) | [i,j] < [N,N] };
    w = [[0.05, 0.15, 0.05],
         [0.15, 0.20, 0.15],
         [0.05, 0.15, 0.05]];

    for (i = 0; _lt_SxS_(i, 250); i = _add_SxS_(i, 1)) {
        rapl = Rapl::raplStart(0);
        sec1, nsec1 = MTClock::gettime();

        a = stencil(a, w);

        sec2, nsec2 = MTClock::gettime();
        energy_uj = Rapl::raplStop(0, rapl);
        printf("%g,%g\n", MTClock::timediff(sec1, nsec1, sec2, nsec2), Rapl::tod(energy_uj));
    }

    return 0;
}
